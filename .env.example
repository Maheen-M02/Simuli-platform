# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required ---
# For OpenRouter this is your OpenRouter key (sk-or-v1-...).
OPENAI_API_KEY=sk-or-v1-...

# --- Endpoint ---
# Point the OpenAI SDK at any OpenAI-compatible endpoint. Leave unset for
# OpenAI itself.
#
# The endpoint MUST honour response_format with a strict json_schema. Both the
# planner and the evaluator depend on it, and some endpoints accept the
# parameter and silently ignore it, returning prose with a 200. The client
# detects that and fails loudly rather than degrading — but check before you
# spend a run on it:
#
#   npm run check:endpoint -- --model <model-id>
#
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter routes one model id across several upstream providers, and they do
# not all support structured output. Setting this sends
# provider.require_parameters, so OpenRouter only routes to a provider that
# supports the parameters we asked for. Strongly recommended on OpenRouter;
# leave unset on OpenAI, which rejects unknown request fields.
LLM_REQUIRE_STRUCTURED_OUTPUT=1

# Optional attribution, shown on your OpenRouter activity page. Harmless if
# unset, ignored by other endpoints.
# OPENROUTER_APP_TITLE=simuli-platform
# OPENROUTER_APP_URL=https://github.com/your-org/simuli-platform

# --- Second provider: NVIDIA (for `npm run benchmark:models`) ---
# NVIDIA's OpenAI-compatible endpoint. Leave the key unset and the benchmark
# reports NVIDIA as skipped rather than failing halfway through.
NVIDIA_API_KEY=nvapi-...
# Nemotron Ultra. Verify any id before spending a benchmark on it:
#   npm run check:endpoint -- --model nvidia/llama-3.1-nemotron-ultra-253b-v1
# NVIDIA's catalogue lists models that are not served to a given account, and
# those return 404 "not found for account" on use.
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# --- Token and cost control ---
# Cap on the planner's reply. One action plus its reasoning is a few hundred
# tokens; a larger budget is billed by a metered endpoint and refused outright
# by a prepaid one.
PLANNER_MAX_OUTPUT_TOKENS=1024

# Per-million-token rates, used only to cost a benchmark. Both halves of a pair
# must be set or the pair is ignored. Nothing is guessed: with these unset the
# benchmark prints "rates not configured" rather than an invented price.
# OPENAI_COST_INPUT_PER_M=
# OPENAI_COST_OUTPUT_PER_M=
# NVIDIA_COST_INPUT_PER_M=
# NVIDIA_COST_OUTPUT_PER_M=

# --- Models ---
# On OpenRouter, ids are vendor-prefixed. Pick models that support structured
# output; verify with `npm run check:endpoint` rather than assuming.
#
# Note: `:free` variants are heavily rate-limited and frequently do not support
# structured output at all. They are not usable for this system.
#
# The planner drives the browser and needs good judgment about a page.
OPENAI_PLANNER_MODEL=openai/gpt-4.1
# The evaluator judges a finished run. It must follow citation instructions
# precisely — cite fact ids, never beliefs — so do not economise here. A weak
# evaluator produces false claims about a customer's product, which is the one
# failure this system exists to avoid.
OPENAI_EVALUATOR_MODEL=openai/gpt-4.1

# --- Logging / browser ---
# trace | debug | info | warn | error
LOG_LEVEL=info
# Set to 0 to watch the browser drive itself.
HEADLESS=1

# --- Target-site credentials ---
# Referenced by name from actions as {"secret": "password"} and resolved at
# execution time. Values never enter prompts, model output, logs or records.
SIM_SECRET_EMAIL=
SIM_SECRET_PASSWORD=
