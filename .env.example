# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required ---
OPENAI_API_KEY=sk-...

# --- Optional ---
# Point at any OpenAI-compatible endpoint instead of OpenAI itself.
#
# The endpoint MUST honour response_format with a strict json_schema. Some
# gateways accept the parameter and silently ignore it, returning prose with a
# 200; the client detects that and fails loudly rather than degrading.
#
# Verified on NVIDIA NIM (https://integrate.api.nvidia.com/v1):
#   openai/gpt-oss-120b   honours the schema   <- use this
#   openai/gpt-oss-20b    honours the schema
#   meta/llama-3.2-*      IGNORES the schema, returns prose
# Note NIM lists models in /v1/models that are not actually served to a given
# account; those return 404 "not found for account".
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# Model used by the planner (the agent's decision-making).
OPENAI_PLANNER_MODEL=gpt-4.1
# Model used by the offline evaluator.
OPENAI_EVALUATOR_MODEL=gpt-4.1
# trace | debug | info | warn | error
LOG_LEVEL=info
# Set to 0 to watch the browser drive itself.
HEADLESS=1

# --- Target-site credentials ---
# Referenced by name from actions as {"secret": "password"} and resolved at
# execution time. Values never enter prompts, model output, logs or records.
SIM_SECRET_EMAIL=
SIM_SECRET_PASSWORD=
