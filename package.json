{
  "name": "simuli-platform",
  "version": "0.0.0",
  "private": true,
  "description": "AI customer simulation — run a realistic AI persona through a real product in a real browser.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "agent": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "openai": "^6.9.0",
    "pino": "^10.0.0",
    "playwright": "^1.57.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
